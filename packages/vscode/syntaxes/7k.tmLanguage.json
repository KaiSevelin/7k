{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "7K",
  "scopeName": "source.7k",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#annotation"
    },
    {
      "include": "#regex"
    },
    {
      "include": "#number"
    },
    {
      "include": "#declarationName"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#typeName"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.7k",
          "match": "//.*$"
        },
        {
          "name": "comment.block.7k",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.7k",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.7k",
          "match": "\\\\(?:[nrt\\\\\"]|u[0-9A-Fa-f]{4})"
        },
        {
          "name": "variable.language.directive.7k",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "annotation": {
      "name": "entity.name.tag.annotation.7k",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "regex": {
      "name": "string.regexp.7k",
      "begin": "/(?![/*])",
      "end": "/\\s*(?i:(re2|pcre|ecma))?",
      "endCaptures": {
        "1": {
          "name": "storage.modifier.dialect.7k"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.7k",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.version.7k",
          "match": "(?i)\\bv[0-9]+(?:\\.(?:[0-9]+|x))?\\b"
        },
        {
          "name": "constant.numeric.duration.7k",
          "match": "(?i)\\b[0-9][0-9_]*(?:ms|s|m|h|d)+\\b"
        },
        {
          "name": "constant.numeric.size.7k",
          "match": "(?i)\\b[0-9][0-9_]*(?:kb|mb|b)\\b"
        },
        {
          "name": "constant.numeric.decimal.7k",
          "match": "\\b[0-9][0-9_]*\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.7k",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "declarationName": {
      "match": "(?i)\\b(package|import|label|value|enum|record|envelope|message|upcast|pipe|service|saga|schedule|scenarios|scenario|soak|mockset|mock|step|state)\\b\\s+([A-Za-z_][A-Za-z0-9_.]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.7k"
        },
        "2": {
          "name": "entity.name.type.7k"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.declaration.7k",
          "match": "(?i)\\b(scenarios|envelope|schedule|scenario|package|message|service|mockset|import|record|upcast|label|value|state|enum|pipe|saga|soak|mock|step)\\b"
        },
        {
          "name": "keyword.control.7k",
          "match": "(?i)\\b(concurrency|multipleof|envelopes|invariant|retention|normalize|delivery|ordering|requires|deadline|onmissed|sequence|rejected|include|durable|maxsize|carries|accepts|replies|timeout|advance|publish|exactly|handled|default|example|pattern|reacts|claims|expect|reason|length|unique|emits|where|retry|start|keyed|every|reply|count|stuck|range|tier|once|send|undo|seed|size|dlq|per|use|on|at|no)\\b"
        },
        {
          "name": "constant.language.7k",
          "match": "(?i)\\b(effectively\\-once|at\\-least\\-once|collapsespace|at\\-most\\-once|unchecked|complete|abandon|stream|linear|reject|absent|queue|topic|false|strip|upper|lower|none|skip|hang|fail|true|trim|nfkc|pcre|ecma|all|nfc|re2)\\b"
        },
        {
          "name": "keyword.operator.word.7k",
          "match": "(?i)\\b(otherwise|contains|within|after|claim|from|with|then|when|max|for|and|not|to|as|by|in|or)\\b"
        },
        {
          "name": "support.type.primitive.7k",
          "match": "(?i)\\b(duration|instant|decimal|string|float|bytes|bool|uuid|date|int|map)\\b"
        },
        {
          "name": "invalid.deprecated.reserved.7k",
          "match": "(?i)\\b(cancel|timer|cron)\\b"
        }
      ]
    },
    "typeName": {
      "name": "entity.name.type.7k",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.7k",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.range.7k",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.alternative.7k",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.assignment.7k",
          "match": "="
        },
        {
          "name": "punctuation.separator.7k",
          "match": "[:;,.?]"
        },
        {
          "name": "punctuation.section.7k",
          "match": "[{}\\[\\]()]"
        }
      ]
    }
  }
}
