{
  "name": "sevenk-vscode",
  "displayName": "7K",
  "description": "Syntax highlighting, diagnostics and completion for the 7K modelling language",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:7k",
    "workspaceContains:**/*.7k"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "7k",
        "aliases": [
          "7K"
        ],
        "extensions": [
          ".7k"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "7k",
        "scopeName": "source.7k",
        "path": "./syntaxes/7k.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[7k]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  },
  "scripts": {
    "gen": "tsx scripts/gen-grammar.ts"
  },
  "dependencies": {
    "@sevenk/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
