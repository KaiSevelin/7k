// A small complete system: three services, an external trigger, one saga.
//
// Small systems are one package. There is nothing here for layers or
// sub-packages to do, and no @internal messages - every message in a
// single-package system is either public or pointless.
//
// All three layers are specified; the saga is at the end of the file.

package acme.shop
envelopes Trace, Caller

// ---------------------------------------------------------------- vocabulary

value OrderRef     : string { length 1..32; example "ORD-1041" }
value CustomerRef  : string { length 1..32 }
value UserRef      : string { length 1..64 }
value ShipmentRef  : string { length 1..32 }
value CardToken    : string { length 1..64 }
value Sku          : string { length 1..24; normalize upper; example "SKU-77" }
value Qty          : int    { range 1..99 }
value CurrencyCode : string { length 3; normalize upper }
value Line60       : string { length 1..60; normalize trim, collapseSpace }

enum DeclineReason {
  InsufficientFunds
  CardExpired
  SuspectedFraud
}

record Money {
  amount:   decimal(18,2) { range 0.. }
  currency: CurrencyCode
}

record OrderLine {
  sku:  Sku
  qty:  Qty
  unit: Money
}

envelope Trace {
  correlationId: uuid @role(correlation)
  causationId:   uuid @derive(inbound.id) @role(causation)
}

envelope Caller {
  customerId: CustomerRef @role(partitionKey)
  actor:      UserRef     @role(subject)
}

// ---------------------------------------------------------------- messages

// Crosses the boundary: sent by the storefront.
message PlaceOrder v1.0 @command {
  orderId: OrderRef @role(businessKey)
  lines:   [OrderLine] { size 1..50 }
  total:   Money
  card:    CardToken

  invariant total.currency == lines[].unit.currency
}

message OrderAccepted v1.0 @event {
  orderId: OrderRef @role(businessKey)
}

message ChargeCard v1.0 @command {
  orderId: OrderRef @role(businessKey)
  amount:  Money
  card:    CardToken
}

message CardCharged v1.0 @event {
  orderId:  OrderRef @role(businessKey)
  chargeId: uuid
}

message CardDeclined v1.0 @event {
  orderId: OrderRef @role(businessKey)
  reason:  DeclineReason
}

message RefundCard v1.0 @command {
  orderId:  OrderRef @role(businessKey)
  chargeId: uuid
  amount:   Money
}

message CardRefunded v1.0 @event {
  orderId: OrderRef @role(businessKey)
}

message ArrangeShipment v1.0 @command {
  orderId: OrderRef @role(businessKey)
  lines:   [OrderLine] { size 1..50 }
}

message ShipmentBooked v1.0 @event {
  orderId:  OrderRef @role(businessKey)
  shipment: ShipmentRef
}

message ShipmentRejected v1.0 @event {
  orderId: OrderRef @role(businessKey)
  detail:  Line60
}

// Saga outcomes.
message OrderCompleted v1.0 @event {
  orderId: OrderRef @role(businessKey)
}

message OrderRejected v1.0 @event {
  orderId: OrderRef @role(businessKey)
  detail:  Line60
}

// Recurring work, driven by the schedule at the end of this file rather than by a
// request. The business key is the day being settled, which is also what makes a repeated
// firing idempotent - timer delivery is at-least-once like everything else.
message SettleDay v1.0 @command {
  day: date @role(businessKey)
}

message DaySettled v1.0 @event {
  day:     date @role(businessKey)
  charged: Money
}

message OrderAbandoned v1.0 @event {
  orderId: OrderRef @role(businessKey)
}

// ---------------------------------------------------------------- pipes
//
// Three pipes, and almost nothing declared: at-least-once delivery, durability
// and a `<pipe>.dead` dead-letter queue for each are all defaults.

// The boundary. Its producer is @external, so Core marks it a boundary pipe and
// the JSON Schema projection for it is `strict`.
pipe inbound : queue {
  ordering by customerId
}

pipe commands : queue {
  ordering by customerId
  carries  ChargeCard, RefundCard, ArrangeShipment
}

pipe events : topic {
  ordering  by customerId
  retention 7d
}

// ---------------------------------------------------------------- services

// The storefront. Not generated by 7K - only the connection is modelled, because
// messages cross it. An implementation maps `inbound` onto an HTTP ingress.
service Storefront @external {
  emits PlaceOrder to inbound

  // The app shows order status, so it observes the outcomes it caused. Without
  // these, `orphan-message` reports four events emitted into nothing - which is
  // exactly the question the analysis exists to ask.
  reacts OrderAccepted  from events { once per orderId; replies none }
  reacts DaySettled     from events { once per day;     replies none }
  reacts OrderCompleted from events { once per orderId; replies none }
  reacts OrderRejected  from events { once per orderId; replies none }
  reacts OrderAbandoned from events { once per orderId; replies none }
}

// Accepts orders and hosts the Checkout saga.
service OrderService {
  emits OrderAccepted   to events
  emits OrderCompleted  to events
  emits OrderRejected   to events
  emits OrderAbandoned  to events
  emits ChargeCard      to commands
  emits RefundCard      to commands
  emits ArrangeShipment to commands

  reacts PlaceOrder from inbound {
    requires claim.sub == envelope.customerId
             and claim.scope contains "orders.write"
    replies  OrderAccepted
  }

  // The saga drives these; the service only needs to receive them.
  reacts CardCharged      from events { replies none }
  reacts CardDeclined     from events { replies none }
  reacts CardRefunded     from events { replies none }
  reacts ShipmentBooked   from events { replies none }
  reacts ShipmentRejected from events { replies none }
}

// Owns the nightly close. It exists as its own service because the schedule's `send` is
// routed by the hosting service's `emits`, so whoever holds the recurring work holds the
// routing for it too.
service SettlementService {
  emits SettleDay  to commands
  emits DaySettled to events

  reacts SettleDay from commands {
    // The day is the business key, so a timer that fires twice settles once.
    once per day
    replies DaySettled
    // A generous backoff, because a close must not be abandoned - and long enough that a
    // stuck one is still retrying when tomorrow's is due, which is what makes the
    // no-overlap rule and `onMissed` observable rather than theoretical.
    retry   4 after 6h max 12h
  }
}

service PaymentService {
  emits CardCharged  to events
  emits CardDeclined to events
  emits CardRefunded to events

  reacts ChargeCard from commands {
    requires claim.scope contains "payments.charge"
    replies  CardCharged | CardDeclined
  }

  reacts RefundCard from commands {
    requires claim.scope contains "payments.refund"
    replies  CardRefunded
    retry    8 after 2s max 5m        // a refund must not be abandoned lightly
  }
}

service ShippingService {
  emits ShipmentBooked   to events
  emits ShipmentRejected to events

  reacts ArrangeShipment from commands {
    replies ShipmentBooked | ShipmentRejected
  }
}

// ===========================================================================
// The Process layer. See ../docs/spec/04-process.md.
// `on <trigger> <action>` is the single idiom: a trigger is a message, a
// timeout, a deadline or a terminal state.
// ===========================================================================

saga Checkout v1.0 {

  start on PlaceOrder keyed by orderId {
    total = message.total
    card  = message.card
    lines = message.lines
  }

  // Declared state, assigned only from received messages (D16). The checker can
  // prove chargeId is set before the undo action reads it.
  state {
    total:    Money
    card:     CardToken
    lines:    [OrderLine]
    chargeId: uuid
  }

  step charge {
    // The block says what the message carries. orderId is the instance key and fills
    // itself; amount has to be said, because the state field holding it is `total`.
    send ChargeCard { amount = state.total }

    on CardCharged  { chargeId = message.chargeId }   // no action: continue
    on CardDeclined reject "card declined"
    on timeout 30s  reject "payment timed out"

    // Co-located with the step it reverses, and run only if this step completed. This
    // is the case the per-step choice was made for: the inverse needs chargeId, which
    // only the saga holds, and it is recorded by the `on CardCharged` action above.
    undo with RefundCard { chargeId = state.chargeId; amount = state.total }
  }

  step ship {
    // Nothing to say: orderId is the key and `lines` matches a state field by name.
    send ArrangeShipment

    on ShipmentBooked                                  // continue
    on ShipmentRejected reject "cannot ship"
    on timeout 2m       reject "shipping timed out"

    // Last step: nothing after it to reverse.
  }

  on deadline 24h abandon

  on complete send OrderCompleted

  // `reject "card declined"` would be decoration if nothing could read it back. The
  // reason the saga rejected for is what OrderRejected.detail is for.
  on reject   send OrderRejected { detail = terminal.reason }

  on abandon  send OrderAbandoned
}

// ---------------------------------------------------------------------------
// Recurring work. Both clauses that look optional are required, and for the same
// reason: each has two wrong answers and no safe default.
//
//   the timezone  a local-time schedule across a daylight-saving change either
//                 fires twice or not at all. "02:00 somewhere" is not a time.
//   onMissed      after an outage, `skip` loses the settlements and `all` would
//                 be catastrophic for a notification. Settlement wants them all.
//
// A schedule never overlaps itself: one occurrence is in flight at a time, and one
// that comes due while the last is still running is reported as schedule-overrun -
// which is when onMissed has something to decide.
// ---------------------------------------------------------------------------

schedule NightlySettlement {
  every    "0 2 * * *" in "Europe/Stockholm"

  // The day the occurrence was due, not the day it ran. A catch-up fires late, so for
  // `onMissed all` those differ - and settling the wrong day is the bug this avoids.
  // The date is civil, in the timezone declared above.
  send     SettleDay { day = occurrence.date }

  onMissed all
}

// No strategy clause. Orchestrated versus choreographed is an implementation's
// choice (D48); Core only reports which constructs force a coordinator - here the
// 24h deadline needs a timer owner, so a purely choreographed binding would be
// rejected unless one is named (D15).

// ---------------------------------------------------------------------------
// What the checker reports:
//
//   replies/liveness   every message the saga awaits is in the outcome space of
//                      the handler that produces it - CardCharged | CardDeclined
//                      is exactly PaymentService's declared `replies`, so the
//                      `charge` step is provably exhaustive.
//   unhandled-outcome  none. If ShippingService later added a third reply, the
//                      `ship` step would be flagged until it handled it.
//   liveness           every path terminates: each step has a timeout, and the
//                      saga has a deadline.
//   compensation       `charge` is compensated; `ship` is the last step and needs
//                      none. Nothing is marked undo none.
//   orphan-message     none - Storefront observes the four order outcome events,
//                      which is what removed the warnings this file used to get.
//   missing-dedupe-key none - every message carries @role(businessKey).
//   envelope-break     none - Trace and Caller ride on every message, including
//                      the ones the saga sends.
//   ordering-defeated  none - every subscription inherits `by customerId`.
//   command-on-topic   none - the four @command messages are on queues.
//   boundary pipes     inbound only. It projects JSON Schema in `strict`
//                      mode; commands and events stay tolerant.
//   unexplained-emit   none - OrderCompleted, OrderRejected and OrderAbandoned
//                      are explained by the saga's terminal `on` clauses rather
//                      than by a `replies`.
//
// Implicit, never written: inbound.dead, commands.dead and
// events.dead; at-least-once delivery and durability everywhere;
// serial-per-customer consumption; 3 retries at 1s exponential except on
// RefundCard; deduplication keyed on orderId throughout.
// ---------------------------------------------------------------------------
