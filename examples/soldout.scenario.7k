// Scenarios for the sales-to-ticketing flow. See ../docs/spec/30-scenarios.md
// section 3; payloads are canonical JSON (../docs/spec/01-kernel.md section 7).
//
// The vantage point is acme.retail.sales, not acme.retail.ticketing, and that is
// deliberate: a scenario sees the declarations of the package it references, and
// sales imports ticketing while ticketing knows nothing of sales. Written from the
// ticketing side it could not resolve OrderService at all - which is how the
// checker found this file pointing at the wrong package.

scenarios for acme.retail.sales

// ---------------------------------------------------------------------------
// A shared default mockset. Scenarios inherit it and override only what they are
// testing, so each one stays about a single thing.
// ---------------------------------------------------------------------------

mockset Baseline {
  mock ticketing.TicketService {
    on ticketing.ReserveSeats reply ticketing.SeatsReserved {
                      heldUntil: { $now: "+15m" }
                    } after 150ms
    on ticketing.ReleaseSeats reply none after 50ms
  }
}

// ---------------------------------------------------------------------------
// 1. Conditional outcome: a large booking is rejected.
// ---------------------------------------------------------------------------

scenario SeatsSoldOut {
  seed 42
  use  Baseline

  mock ticketing.TicketService {
    on ticketing.ReserveSeats {
      when message.seats.size > 4 reply ticketing.SeatsRejected {
                                    reason: "SoldOut"
                                  } after 200ms
      otherwise                   reply ticketing.SeatsReserved {
                                    heldUntil: { $now: "+15m" }
                                  } after 200ms
    }
  }

  at 0s publish ticketing.ReserveSeats as OrderService {
    orderId:       "ORD-10432",
    reservationId: "$auto",
    seats:         { $repeat: 6, of: { event: "EV-1", number: "$auto" } }
  }

  advance 1s
  expect ticketing.SeatsRejected on ticketing.events { reason: "SoldOut" }
}

// ---------------------------------------------------------------------------
// 2. Retry path: the handler fails twice, then succeeds. Exercises the
//    subscription's retry policy.
// ---------------------------------------------------------------------------

scenario ReserveRecoversAfterTwoFailures {
  seed 42
  use  Baseline

  mock ticketing.TicketService {
    on ticketing.ReserveSeats {
      sequence {
        fail
        fail
        reply ticketing.SeatsReserved { heldUntil: { $now: "+15m" } }
      }
    }
  }

  at 0s publish ticketing.ReserveSeats as OrderService {
    orderId:       "ORD-1",
    reservationId: "$auto",
    seats:         { $repeat: 2, of: "$auto" }
  }

  advance 10s                        // past two backoff intervals, plus slack
  expect ticketing.SeatsReserved on ticketing.events
  expect no message    on ticketing.commands.dead
}

// ---------------------------------------------------------------------------
// 3. Silence. The handler never answers, so redelivery runs out and the message
//    is dead-lettered - the case that produces stuck orders in real systems.
// ---------------------------------------------------------------------------

scenario ReserveNeverAnswers {
  seed 42
  use  Baseline

  mock ticketing.TicketService {
    on ticketing.ReserveSeats hang
  }

  at 0s publish ticketing.ReserveSeats as OrderService {
    orderId:       "ORD-2",
    reservationId: "$auto",
    seats:         { $repeat: 1, of: "$auto" }
  }

  advance 1m
  expect no message   on ticketing.events
  expect ticketing.ReserveSeats on ticketing.commands.dead
}

// ---------------------------------------------------------------------------
// 4. Duplicate delivery: the handler replies, then fails, so the message is
//    redelivered. Proves the consumer's `once per` key actually works.
//
//    A `sequence` rather than a bare `reply ... then fail`, because a handler that
//    fails on every attempt duplicates once per retry - so the count would be the
//    subscription's retry policy rather than this scenario's point. Replying then
//    failing exactly once, and succeeding on redelivery, is the duplicate a
//    consumer actually has to survive. The fixed reservationId is the dedup key
//    under test, so it is written out rather than generated.
// ---------------------------------------------------------------------------

scenario ReserveRepliesThenFails {
  seed 42
  use  Baseline

  mock ticketing.TicketService {
    on ticketing.ReserveSeats {
      sequence {
        reply ticketing.SeatsReserved { heldUntil: { $now: "+15m" } } then fail
        reply ticketing.SeatsReserved { heldUntil: { $now: "+15m" } }
      }
    }
  }

  at 0s publish ticketing.ReserveSeats as OrderService {
    orderId:       "ORD-3",
    reservationId: "11111111-1111-1111-1111-111111111111",
    seats:         { $repeat: 1, of: "$auto" }
  }

  advance 10s
  expect ticketing.SeatsReserved on ticketing.events count 2   // the pipe really duplicates
  expect OrderService handled ticketing.SeatsReserved count 1  // the key deduplicated it
  expect no message on ticketing.commands.dead                 // and the retry succeeded
}

// ---------------------------------------------------------------------------
// 5. Authorization: the same message with an insufficient claim set.
// ---------------------------------------------------------------------------

scenario ReserveWithoutScope {
  seed 42
  use  Baseline

  at 0s publish ticketing.ReserveSeats as OrderService
    with claims { tid: "acme" }                       // ticketing.write missing
    {
      orderId:       "ORD-4",
      reservationId: "$auto",
      seats:         { $repeat: 1, of: "$auto" }
    }

  expect rejected ticketing.ReserveSeats at ticketing.TicketService reason unauthorized
  expect no message on ticketing.events
}

// ---------------------------------------------------------------------------
// 6. Negative test: a payload that violates its own contract, to exercise the
//    consumer's rejection path rather than its logic.
// ---------------------------------------------------------------------------

scenario ReserveWithBadPayload {
  seed 42
  use  Baseline

  at 0s publish ticketing.ReserveSeats as OrderService
    unchecked                                         // bypass composer validation
    {
      orderId:       { $invalid: "length" },           // exceeds OrderRef length 1..32
      reservationId: "$auto",
      seats:         { $repeat: 0, of: "$auto" }       // violates size 1..20
    }

  expect no message   on ticketing.events
  advance 1s
  expect ticketing.ReserveSeats on ticketing.commands.dead
}

// ---------------------------------------------------------------------------
// 7. Weighted outcomes, under load. Deterministic under `seed`.
//
//    A `soak` rather than a `scenario`: load generation belongs apart so CI can
//    run every scenario on each commit and soaks separately.
// ---------------------------------------------------------------------------

soak ReserveUnderLoad {
  seed 7

  mock ticketing.TicketService {
    on ticketing.ReserveSeats {
      85% reply ticketing.SeatsReserved { heldUntil: { $now: "+15m" } } after 120ms
      10% reply ticketing.SeatsRejected { reason: "SoldOut" }           after 120ms
       5% fail
    }
  }

  every 200ms for 1h publish ticketing.ReserveSeats as OrderService {
    orderId:       "$auto",
    reservationId: "$auto",
    seats:         { $repeat: { $range: [1, 4] }, of: "$auto" }
  }

  expect no message on ticketing.commands.dead
}

// ---------------------------------------------------------------------------
// Open points for the runtime, not the format:
//
//   * `expect ... count n` is cumulative over the run (D62). A scenario asserting
//     a count twice is asserting two totals, not two intervals.
//   * `$invalid` with `unchecked` is how a rejection path gets tested at all; a
//     harness that only permits valid input cannot test the interesting half.
//   * Payloads use relaxed JSON - unquoted keys, comments, trailing commas - per
//     D32 7.4, so a hand-written fixture and a tool-written one will not look
//     identical.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 8. A producer that has not caught up. OrderPlaced is at v1.1; this publishes
//    v1.0, which has no `note` field at all, and the upcast in sales.7k supplies
//    `note = absent` on the way in.
//
//    Pinning the version on a publish is the only way to arrange this: nothing
//    else in a scenario can produce a message from a service still on the old
//    contract, which is why the upcast was declared and never exercised until the
//    runtime could receive one.
// ---------------------------------------------------------------------------

scenario OldOrderPlacedUpcasts {
  seed 1

  at 0s publish OrderPlaced v1.0 as WebApp {
    orderId: "ORD-10500",
    buyer:   "$auto",
    // The currency is written rather than generated, on both sides: OrderPlaced's
    // `invariant total.currency == seats[].price.currency` relates two fields, and
    // independent generation cannot honour a relation it knows nothing about.
    seats:   { $repeat: 2, of: { event: "EV-9", number: "$auto",
                                 price: { amount: "120.0000", currency: "SEK" } } },
    total:   { amount: "240.0000", currency: "SEK" }
  }

  advance 1s
  expect Reporting handled OrderPlaced count 1
}
