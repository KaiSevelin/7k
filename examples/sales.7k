// Sales: the channels that drive ticketing. Depends on acme.ticketing, which
// does not depend back - so there is no package cycle.

package acme.retail.sales

import acme.retail.common
import acme.retail.ticketing

envelopes common.Trace, common.Tenancy

// ---------------------------------------------------------------- messages

message OrderPlaced v1.1 @event {
  orderId: common.OrderRef
  buyer:   common.Buyer
  seats:   [common.SeatPrice] { size 1..20 }
  total:   common.Money
  note:    common.Line60? @since(1.1)

  invariant total.currency == seats[].price.currency
}

upcast OrderPlaced v1.0 to v1.1 {
  note = absent
}

// ---------------------------------------------------------------- pipes

pipe events : topic {
  ordering  by tenantId
  retention 7d
}

// ---------------------------------------------------------------- services

service OrderService {
  emits OrderPlaced             to events
  emits ticketing.ReserveSeats  to ticketing.commands
  emits ticketing.ReleaseSeats  to ticketing.commands

  reacts ticketing.SeatsReserved from ticketing.events {
    requires claim.scope contains "orders.write"
    replies  none
  }

  reacts ticketing.SeatsRejected from ticketing.events {
    replies none
  }
}

service KioskBridge {
  emits OrderPlaced to events

  // Legal because acme.retail.sales is under acme.retail, which is the scope
  // declared on the message.
  //
  // `once per none`: the handler sets a cached availability figure, so replaying
  // it changes nothing. The message has no business identity either - each
  // occurrence is genuinely distinct - so there is nothing to key on.
  reacts ticketing.SeatInventoryChanged from ticketing.events {
    once per none
    replies  none
  }

  // Only this channel's tickets: the broker filters, so other channels'
  // traffic is never delivered here at all.
  reacts ticketing.TicketIssued from ticketing.events {
    accepts v1.0
    where   envelope.channel == Kiosk
    replies none
  }
}

// Not generated by 7K, but it participates in the conversation: in the graph,
// contract-checked, and available as a sender in the Spider composer.
service WebApp @external {
  emits OrderPlaced to events
}

// ---------------------------------------------------------------------------
// What the checker reports across the three example packages:
//
//   internal-leak      none - SeatLedgerAdjusted is package-private and consumed
//                      only inside acme.retail.ticketing; SeatInventoryChanged is
//                      @internal(acme.retail) and KioskBridge is inside that
//                      scope.
//   tier-violation    none - channel depends on domain and platform, both
//                      downward. See retail.7k for the layer declarations.
//   orphan-message     SeatLedgerAdjusted, and OrderPlaced - both emitted with
//                      no modelled consumer. Real, not noise: the analysis is
//                      asking where these events go.
//   package-cycle      none - acme.sales depends on acme.ticketing, not back.
//   unclaimed-role     none - correlation, causation, partitionKey, subject and
//                      businessKey are all claimed.
//   ordering-defeated  none - every subscription inherits `by tenantId` from its
//                      pipe, and `reconcile` narrows to serial rather than
//                      widening.
//   command-on-topic   none - the two @command messages are on a queue, every
//                      @event is on a topic.
//   case-collision     none.
//   deploy-order       KioskBridge accepts TicketIssued v1.0 exactly. A future
//                      v1.1 would require KioskBridge to deploy first.
//   pipe labels        events is pii-bearing (OrderPlaced -> Buyer ->
//                      Address @pii), so an implementation must encrypt it at rest.
//   external-bound     WebApp and PrintGateway are @external, so an implementation
//                      generate them - only their contracts are checked.
//   boundary pipes     events (WebApp emits) and ticketing.print
//                      (PrintGateway consumes). Both project JSON Schema in
//                      `strict` mode; the purely internal pipes stay tolerant.
//
// Implicit, never written: ticketing.commands.dead, ticketing.events.dead and
// events.dead; at-least-once delivery and durability on every live pipe;
// serial-per-tenant consumption; 3 retries at 1s exponential; deduplication keyed
// on each message's @role(businessKey) field.
//
// Renaming any of these three packages would change the wire type of its
// messages. Core reports that rather than preventing it.
// ---------------------------------------------------------------------------
